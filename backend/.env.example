# Copia este archivo como ".env" y rellena los valores. NUNCA subas el .env a Git.

PORT=3000

# Supabase (base de datos)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Administrador: único correo autorizado en /api/admin/*
ADMIN_EMAIL=

# Brevo (envío de correos)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_DESTINO=

# Firebase Admin: en producción (Render) pega aquí el JSON de la cuenta de servicio
# en UNA sola línea. En local puedes omitirlo y usar backend/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=

# CORS (opcional): orígenes permitidos separados por coma, sin barra final.
# Si se omite, se permite https://jorg671.github.io y el entorno local (localhost:5173).
CORS_ORIGINS=


# Inteligencia artificial - Groq
GROQ_API_KEY=
GROQ_API_URL=
GROQ_MODEL=
